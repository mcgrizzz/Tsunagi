{
  "name": "tsunagi-client",
  "version": "0.6.1",
  "description": "Typed client for Tsunagi, the Anki add-on's HTTP API: queries, writes and live updates",
  "keywords": [
    "anki",
    "tsunagi",
    "ankiconnect",
    "flashcards",
    "spaced-repetition",
    "fsrs"
  ],
  "homepage": "https://github.com/mcgrizzz/Tsunagi/tree/main/packages/typescript#readme",
  "bugs": "https://github.com/mcgrizzz/Tsunagi/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcgrizzz/Tsunagi.git",
    "directory": "packages/typescript"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "cases": "python3 ../spec/cases/source/build.py",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run generate && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "npm run cases && npm run build && npm run check && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
