{
  "_": "The client's names (packages/spec/behavior.md, Names and values). Every other wire name becomes the language's case.",
  "resources": {
    "/v1/cards": "cards",
    "/v1/notes": "notes",
    "/v1/reviews": "reviews",
    "/v1/decks": "decks",
    "/v1/note-types": "noteTypes",
    "/v1/deck-presets": "deckPresets",
    "/v1/tags": "tags",
    "/v1/media": "media",
    "/v1/addons": "addons"
  },
  "keys": {
    "tags": "name",
    "media": "filename"
  },
  "omit": {
    "*": [
      "usn",
      "stats"
    ],
    "Health": [
      "ok",
      "version"
    ],
    "CardAnswered": [
      "type",
      "seq",
      "session_id",
      "anki"
    ],
    "NoteTypeRow": [
      "req"
    ]
  },
  "valueOverrides": {
    "ReviewRow.rating": {
      "0": null
    }
  },
  "states": {
    "_": "is(state): the client's name for each of Anki's search states (is:<term>), in the queue's vocabulary.",
    "new": "new",
    "learning": "learn",
    "review": "review",
    "due": "due",
    "buried": "buried",
    "siblingBuried": "buried-sibling",
    "manuallyBuried": "buried-manually",
    "suspended": "suspended"
  },
  "types": {
    "cards": "Card",
    "notes": "Note",
    "reviews": "Review",
    "decks": "Deck",
    "noteTypes": "NoteType",
    "deckPresets": "DeckPreset",
    "tags": "Tag",
    "media": "MediaFile",
    "addons": "Addon"
  },
  "typeNames": {
    "FsrsMemoryState": "MemoryState",
    "NoteField": "NoteField",
    "NoteCreated": "CreatedNote",
    "NoteUpdated": "UpdatedNote",
    "MediaStored": "StoredFile",
    "MediaCreated": "UploadedFile",
    "NoteCreateFailure": "NoteFailure",
    "NoteUpsertFailure": "UpsertFailure",
    "MediaCreateFailure": "MediaFailure",
    "NoteCheckResult": "NoteCheck",
    "CallerInfo": "Caller",
    "VerbResult": "VerbReport",
    "MutationResult_Any_": "MutationResult",
    "JobInfo": "Job",
    "CardAnswered": "Answer"
  },
  "operations": {
    "notesCreate": "POST /v1/notes",
    "notesUpdate": "PATCH /v1/notes/{id}",
    "notesCheck": "POST /v1/notes:check",
    "notesUpsert": "POST /v1/notes:upsert",
    "notesDelete": "POST /v1/notes:delete",
    "cardsSuspend": "POST /v1/cards:suspend",
    "cardsUnsuspend": "POST /v1/cards:unsuspend",
    "cardsBury": "POST /v1/cards:bury",
    "cardsUnbury": "POST /v1/cards:unbury",
    "cardsForget": "POST /v1/cards:forget",
    "cardsSetDueDate": "POST /v1/cards:set-due-date",
    "cardsChangeDeck": "POST /v1/cards:change-deck",
    "cardsReposition": "POST /v1/cards:reposition",
    "cardsSetFlag": "POST /v1/cards:set-flag",
    "cardsAnswer": "POST /v1/cards:answer",
    "mediaUpload": "POST /v1/media",
    "sync": "POST /v1/collection:sync",
    "job": "GET /v1/jobs/{job_id}",
    "health": "GET /v1/health",
    "capabilities": "GET /v1/capabilities",
    "guiBrowse": "POST /v1/gui:browse",
    "guiEditNote": "POST /v1/gui:edit-note",
    "guiAddCards": "POST /v1/gui:add-cards",
    "guiDeckOverview": "POST /v1/gui:deck-overview",
    "guiDeckReview": "POST /v1/gui:deck-review"
  }
}
